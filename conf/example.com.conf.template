# 监听 80 端口，重定向所有 HTTP 请求到 HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name %DOMAIN%;
    return 301 https://$host$request_uri;
}

# 监听 443（TCP + QUIC/HTTP/3）
# 部署时请确保同时映射 TCP 443 与 UDP 443
server {
    listen 443 quic;
    listen [::]:443 quic;
    http3 on;
    quic_retry on;

    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name %DOMAIN%;
    index index.html index.php;
    root /www/wwwroot/%DOMAIN%;

    error_page 497 https://$host$request_uri;
    add_header Alt-Svc 'h3=":443"; ma=86400';
    http3_max_concurrent_streams 128;

    ssl_certificate %NGINX_DIR%/ssl/%DOMAIN%/fullchain.pem;
    ssl_certificate_key %NGINX_DIR%/ssl/%DOMAIN%/privkey.pem;
    ssl_trusted_certificate %NGINX_DIR%/ssl/%DOMAIN%/ca.pem;

    # 会话/协议继承全局 http{}；站点仅保留必要覆盖
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    include %NGINX_DIR%/conf/security-headers-common.conf;
    add_header X-Frame-Options "DENY" always;

    # 默认偏严格 CSP；第三方脚本请按业务白名单放行，勿直接放开任意 https:
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" always;

    limit_req zone=req_limit burst=20 nodelay;
    limit_conn perip 40;
    limit_conn perserver 200;

    location / {
        try_files $uri $uri/ /index.php?$args;
        limit_except GET HEAD POST PUT PATCH DELETE OPTIONS {
            deny all;
        }
    }

    location ~* ^/wp-content/uploads/.*\.php$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    #include %NGINX_DIR%/conf/php/enable-php-84.conf;

    location ~ ^/(\.user.ini|\.htaccess|\.git|\.env|\.svn|\.project|LICENSE|README.md|\.stfolder|\.stignore) {
        return 444;
    }

    # 常见恶意扫描 UA（不含 curl/wget/python）
    if ($http_user_agent ~* (HTTrack|nikto|sqlmap|fimap|nmap|masscan|zgrab|dirbuster)) {
        return 403;
    }

    if ( $uri ~ "^/\.well-known/.*\.(php|jsp|py|js|css|lua|ts|go|zip|tar\.gz|rar|7z|sql|bak)$" ) {
        return 403;
    }

    location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$ {
        expires 30d;
        access_log off;
    }

    location ~ .*\.(js|css)$ {
        expires 12h;
        access_log off;
    }

    location ~ /\. {
        deny all;
    }

    access_log %NGINX_DIR%/logs/%DOMAIN%.log main;
    access_log %NGINX_DIR%/logs/%DOMAIN%.json json_combined;
    error_log %NGINX_DIR%/logs/%DOMAIN%.error.log;
}
